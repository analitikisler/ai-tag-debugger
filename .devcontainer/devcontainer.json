{
  "name": "ai-tag-debugger",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  // Installs the dependencies, Chromium and its system libraries.
  "postCreateCommand": "npm run setup -- --with-deps",
  // The demo shop (npm run demo:serve).
